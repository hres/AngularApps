{
  "name": "pbv-co",
  "version": "5.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 8201 -o",
    "build": "npm run build-prod & npm run build-dev",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build-prod": "npm run build-prod-external & npm run build-prod-internal",
    "build-prod-external": "npm run build-prod-external-en & npm run build-prod-external-fr",
    "build-prod-external-en": "ng build --configuration=production-external-en && npm run post-build -- --template=pbv-co --type=external --env=prod --language=en",
    "build-prod-external-fr": "ng build --configuration=production-external-fr && npm run post-build -- --template=pbv-co --type=external --env=prod --language=fr ",
    "build-prod-internal": "npm run build-prod-internal-en & npm run build-prod-internal-fr",
    "build-prod-internal-en": "ng build --configuration=production-internal-en && npm run post-build -- --template=pbv-co --type=internal --env=prod --language=en",
    "build-prod-internal-fr": "ng build --configuration=production-internal-fr && npm run post-build -- --template=pbv-co --type=internal --env=prod --language=fr ",
    "build-dev": "npm run build-dev-en & npm run build-dev-fr",
    "build-dev-en": "ng build --configuration=development-en && npm run post-build -- --template=pbv-co --type=external --env=dev --language=en ",
    "build-dev-fr": "ng build --configuration=development-fr && npm run post-build -- --template=pbv-co --type=external --env=dev --language=fr ",
    "post-build": "python ../../python/post-app-build/post-build.py"
  },
  "dependencies": {
    "@hpfb/pbv": "file:../../libs/hpfb-pbv-1.3.0.tgz",
    "@hpfb/sdk": "file:../../libs/hpfb-sdk-1.8.0.tgz"
  },
  "private": true
}
