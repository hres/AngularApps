{
  "name": "angular-apps",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "========== comment line, Master File ==========": "",
    "start-mf:rt": "pnpm --filter mf-rt start",
    "build-mf-rt": "npm run clean-dist && pnpm --filter mf-rt build",
    "========== comment line, PharmaBio REP RT ==========": "",
    "start-pbv:rt": "pnpm --filter pbv-rt start",
    "build-pbv-rt": "npm run clean-dist && pnpm --filter pbv-rt build",
    "========== comment line, PharmaBio REP PI ==========": "",
    "start-pbv:pi": "pnpm --filter pbv-pi start",
    "build-pbv-pi": "npm run clean-dist && pnpm --filter pbv-pi build",
    "========== comment line, PharmaBio REP CO ==========": "",
    "start-pbv:co": "pnpm --filter pbv-co start",
    "build-pbv-co": "npm run clean-dist && pnpm --filter pbv-co build",
    "========== comment line, Certificate of Supplementary Protection ==========": "",
    "start-csp:rt": "pnpm --filter csp start",
    "build-csp-rt": "npm run clean-dist && pnpm --filter csp build",
    "========== comment line, Medical Device CO ==========": "",
    "start-md:co": "pnpm --filter md-co start",
    "build-md-co": "npm run clean-dist && pnpm --filter md-co build",
    "========== comment line, Medical Device AI ==========": "",
    "start-md:ai": "pnpm --filter md-ai start",
    "build-md-ai": "npm run clean-dist && pnpm --filter md-ai build",
    "========== comment line, Medical Device RT ==========": "",
    "start-md:rt": "pnpm --filter md-rt start",
    "build-md-rt": "npm run clean-dist && pnpm --filter md-rt build",
    "========== comment line, hpfb/sdk lib scripts==========": "",
    "========== How to update in other apps: Run sdk-lib:buildPackageAndMove, then run pnpm install, than start application above ==========": "",
    "sdk-lib-increment-build-number": "pnpm run increment-build-number  ./projects/hpfb/sdk/package.json",
    "sdk-lib:build": "pnpm run sdk-lib-increment-build-number && ng build @hpfb/sdk",
    "sdk-lib:watch": "ng build @hpfb/sdk --watch --configuration development",
    "sdk-lib:package": "cd dist/hpfb/sdk && npm pack",
    "sdk-lib:move": "npm run move-file -- --source_relative_path ./dist/hpfb/sdk --filename_pattern hpfb-sdk-*.tgz --destination_relative_path ./libs",
    "sdk-lib:buildPackageAndMove": "run-s sdk-lib:build sdk-lib:package sdk-lib:move",
    "========== comment line, hpfb/pbv lib scripts==========": "",
    "========== How to update in other apps: Run pbv-lib:buildPackageAndMove, then run pnpm install, than start application above ==========": "",
    "pbv-lib-increment-build-number": "pnpm run increment-build-number  ./projects/hpfb/pbv/package.json",
    "pbv-lib:build": "pnpm run pbv-lib-increment-build-number && ng build @hpfb/pbv",
    "pbv-lib:adjust-dependencies": "python ./python/utils/change-dependency.py pbv",
    "pbv-lib:watch": "ng build @hpfb/pbv --watch --configuration development",
    "pbv-lib:package": "cd dist/hpfb/pbv && npm pack",
    "pbv-lib:move": "npm run move-file -- --source_relative_path ./dist/hpfb/pbv --filename_pattern hpfb-pbv-*.tgz --destination_relative_path ./libs",
    "pbv-lib:buildPackageAndMove": "run-s pbv-lib:build pbv-lib:adjust-dependencies pbv-lib:package pbv-lib:move",
    "========== How to update in other apps: Run md-lib:buildPackageAndMove, then run pnpm install, than start application above ==========": "",
    "md-lib-increment-build-number": "pnpm run increment-build-number  ./projects/hpfb/md/package.json",
    "md-lib:build": "pnpm run md-lib-increment-build-number && ng build @hpfb/md",
    "md-lib:adjust-dependencies": "python ./python/utils/change-dependency.py md",
    "md-lib:watch": "ng build @hpfb/md --watch --configuration development",
    "md-lib:package": "cd dist/hpfb/md && npm pack",
    "md-lib:move": "npm run move-file -- --source_relative_path ./dist/hpfb/md --filename_pattern hpfb-md-*.tgz --destination_relative_path ./libs",
    "md-lib:buildPackageAndMove": "run-s md-lib:build md-lib:adjust-dependencies md-lib:package md-lib:move",
    "========== comment line, util scripts==========": "",
    "clean-dist": "rimraf dist",
    "move-file": "python ./python/utils/move-file.py ",
    "increment-build-number": "python ./python/utils/increment-build-number.py "
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.3",
    "@angular/common": "^22.0.3",
    "@angular/compiler": "^22.0.3",
    "@angular/core": "^22.0.3",
    "@angular/forms": "^22.0.3",
    "@angular/platform-browser": "^22.0.3",
    "@angular/platform-browser-dynamic": "^22.0.3",
    "@angular/router": "^22.0.3",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "cpx": "^1.5.0",
    "crypto-js": "^4.2.0",
    "deepmerge-ts": "^7.1.3",
    "file-saver": "^2.0.5",
    "font-awesome": "^4.7.0",
    "jquery": "^3.7.1",
    "ngx-translate-multi-http-loader": "^18.2.0",
    "replace-in-file": "^7.2.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.0",
    "util": "^0.12.5",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.4",
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.4",
    "@types/jquery": "^3.5.32",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "minimatch": "^10.0.1",
    "ng-packagr": "^22.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.10",
    "typescript": "~6.0.3",
    "wait-on": "^7.2.0"
  }
}